# Deployment target: "development" or "production" (used by docker-run.sh)
TARGET=production

# Public hostname Traefik routes to this service (production).
DOMAIN=sms-gateway.example.com

# Signing Key from the phone app: Settings -> Webhooks -> Signing Key.
# Must match exactly for signature verification to pass.
SIGNING_KEY=change-me

# Optional overrides:
# PORT=8080
# DB_PATH=/data/sms.db

# Replay guard: reject webhooks whose X-Timestamp differs from the server clock
# by more than this many seconds (default 300). 0 disables.
# MAX_SKEW_SECONDS=300

# --- Read API (/api/messages) auth -------------------------------------------
# These guard the *read* side only; /webhook is always guarded by SIGNING_KEY.
#
# WARNING: leaving OIDC_ISSUER unset does NOT close /api — it disables auth and
# serves your whole SMS history (including one-time passcodes) to anyone who can
# reach the host. Set it for any deployment that is publicly routable.

# Dex issuer URL. JWKS is fetched from <issuer>/keys.
OIDC_ISSUER=https://dex.example.com

# Expected `aud` claim; must match the Dex static client (default sms-gateway).
OIDC_CLIENT_ID=sms-gateway

# Only this `email` claim may read the API. Empty = any account Dex issues a
# token for, which is rarely what you want.
ALLOWED_EMAIL=you@example.com

# Directory of built frontend assets to serve at `/`. Empty disables serving.
# Assets here are public — auth applies to /api, not to static files.
# FRONTEND_DIR=/app/web/dist
